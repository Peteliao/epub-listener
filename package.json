{
  "name": "epub-listener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:polyphones": "node scripts/audit-polyphones.mjs",
    "audit:golden": "node scripts/audit-golden.mjs --all",
    "regression:build": "node scripts/build-pronunciation-regression.mjs",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "lab:ab": "node tests/browser/run-ab.mjs",
    "lab:smoke": "node tests/browser/run-ab.mjs --smoke",
    "lab:stats": "node scripts/ab-stats.mjs",
    "reports:overlay": "node scripts/reports-to-overlay.mjs"
  },
  "dependencies": {
    "driver.js": "^1.10.2",
    "epubjs": "^0.3.93",
    "idb": "^8.0.4",
    "pinia": "^4.1.0",
    "pinyin-pro": "^3.29.5",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
